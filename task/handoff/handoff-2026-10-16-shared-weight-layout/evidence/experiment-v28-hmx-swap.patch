+            hvx_vmemu(st->dst+r*st->stride+ct*32)=Q6_V_lo_W(pair);
+            if(r+1<st->rows) {
+                hvx_vmemu(st->dst+(r+1)*st->stride+ct*32)=Q6_V_hi_W(pair);
+            }
+        }
+    }
+    htp_trace_event_stop(&st->traces[i],HTP_TRACE_EVT_HVX_O_PROC,i);

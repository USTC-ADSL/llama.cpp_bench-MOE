+static void cpu4x8_output_worker(unsigned int n, unsigned int i, void *data) {
+    cpu4x8_output_state *st=data;
+    const uint32_t token_tiles=(st->rows+31)/32;
+    const HVX_Vector offsets=hvx_vmem(cpu4x8_pair_offsets);
+    htp_trace_event_start(&st->traces[i],HTP_TRACE_EVT_HVX_O_PROC,i);
+    for(uint32_t ct=i;ct<st->cols/32;ct+=n) {
+        for(uint32_t r=0;r<st->rows;r+=2) {
+            const __fp16 *tile=st->src+(ct*token_tiles+r/32)*1024;
+            HVX_Vector off=Q6_Vw_vadd_VwVw(offsets,Q6_V_vsplat_R((r%32)*4));

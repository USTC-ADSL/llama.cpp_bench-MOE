LD_LIBRARY_PATH=/data/local/tmp/bench-PD:$LD_LIBRARY_PATH
ADSP_LIBRARY_PATH=/data/local/tmp/bench-PD
GGML_QNN_DISABLE_BACKEND=1
GGML_HETERO_DYNAMIC_ALLOW_QNN=0
GGML_HETERO_ENABLE_OPENCL_CPU_EXTRA_CPU_COPY=1
GGML_HETERO_DISABLE_CPU_OPENCL_SHARED_HOST=1
GGML_HETERO_DYNAMIC_MODE=phase
GGML_HETERO_DYNAMIC_PREFILL_ROUTE=opencl
GGML_HETERO_DYNAMIC_DECODE_ROUTE=cpu
GGML_HETERO_DYNAMIC_TRACE=1
GGML_HETERO_DYNAMIC_TRACE_TIMING=1
GGML_HETERO_TRACE_SHARE=1
GGML_HETERO_DYNAMIC_PRERESERVE=1
